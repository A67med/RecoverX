# Text files are normalised to LF in the repository.
* text=auto

# Windows scripts must keep CRLF line endings (cmd.exe label parsing)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF so they run on Linux
*.sh text eol=lf

# Evidence-like and reference material is byte-exact: never convert line endings.
# (validation/originals are ground-truth files whose SHA-256 is checked.)
validation/originals/** binary
research/results/** -text
research/datasets/** -text
*.pdf binary
*.PDF binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.png binary
*.PNG binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.bz2 binary
*.joblib binary
*.img binary
*.dd binary
