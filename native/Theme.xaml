<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Button">
  <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="#F1F2FA"/><Setter Property="Background" Value="#242535"/><Setter Property="BorderBrush" Value="#424456"/>
  <Setter Property="Padding" Value="15,10"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#D2CEFF"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#B9F9EE"/><Setter TargetName="frame" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Opacity" Value=".78"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Opacity" Value=".46"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F1F2FA"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="#C6C7DB"/><Setter Property="FontSize" Value="13"/></Style>
</ResourceDictionary>
